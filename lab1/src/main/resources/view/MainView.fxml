<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="by.bsuir.agecalc.controller.MainController"
      alignment="CENTER" spacing="15" prefWidth="420" prefHeight="380">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Возраст в неожиданных единицах"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Button text="Ввести данные" onAction="#handleOpenInput"/>

    <Label fx:id="lblBirthDate" text="Дата рождения: не введена"/>

    <Separator/>

    <Label text="Результат:" style="-fx-font-weight: bold;"/>
    <Label fx:id="lblResult" text="—" wrapText="true"/>

    <Label fx:id="lblError" style="-fx-text-fill: red;" wrapText="true"/>
</VBox>